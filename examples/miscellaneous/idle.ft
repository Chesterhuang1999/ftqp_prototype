hardware superconducting = {
  t1: 1e-8, t2: 1e-7, tm: 1e-6, p1: 1e-3, p2: 2e-3, pm: 3e-3
};


qecc surface_code_27 using superconducting = {
  [[n,k,d]]: [729, 1, 27],
  SE: { "#ancilla": "n-1", tSE: "2t1+4t2+tm" },
  PREP: { time: "t1+d*tSE", "#SE": "d", "#ancilla": "0" },
  OPL: {
    I: { arity: 1, time: "0", "#SE": "0", "#ancilla": "0" },
    X: { arity: 1, time: "t1+d*tSE", "#SE": "d", "#ancilla": "0" },
    Z: { arity: 1, time: "t1+d*tSE", "#SE": "d", "#ancilla": "0" },
    H: { arity: 1, time: "t1+d*tSE", "#SE": "d", "#ancilla": "0" },
    measZ: { arity: 1, time: "d*tSE", "#SE": "d", "#ancilla": "0" }
  },
  OPF: {
    faultyT: { arity: 1, time: "2t1+2tm", pF: "max(p1, p2, pm)", "#ancilla": "0"
    }
  },
  tdec: "255*tSE",
  pL: "0.1*(max(p1,p2,pm)/0.0057)^((d+1)/2)",
  naux: "d*d"
};

qecc surface_code_25 using superconducting = {
  [[n,k,d]]: [625, 1, 25],
  SE: { "#ancilla": "n-1", tSE: "2t1+4t2+tm" },
  PREP: { time: "t1+d*tSE", "#SE": "d", "#ancilla": "0" },
  OPL: {
    I: { arity: 1, time: "0", "#SE": "0", "#ancilla": "0" },
    X: { arity: 1, time: "t1+d*tSE", "#SE": "d", "#ancilla": "0" },
    Z: { arity: 1, time: "t1+d*tSE", "#SE": "d", "#ancilla": "0" },
    H: { arity: 1, time: "t1+d*tSE", "#SE": "d", "#ancilla": "0" },
    measZ: { arity: 1, time: "d*tSE", "#SE": "d", "#ancilla": "0" }
  },
  OPF: {
    faultyT: { arity: 1, time: "2t1+2tm", pF: "max(p1, p2, pm)", "#ancilla": "0"
    }
  },
  tdec: "0*tSE",
  pL: "0.1*(max(p1,p2,pm)/0.0057)^((d+1)/2)",
  naux: "d*d"
};


program {
    logical anc := new surface_code_27;
    logical q := new surface_code_27;
    prepare(q);
    H[anc];H[anc];H[anc];H[anc];H[anc];H[anc];
    release(q);
    release(anc);
}