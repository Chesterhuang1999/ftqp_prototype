hardware superconducting = {
  t1: 1e-8, t2: 1e-7, tm: 1e-6, p1: 1e-4, p2: 1e-4, pm: 1e-4
};

qecc surface_code using superconducting = {
  [[n,k,d]]: [441, 1, 21],
  SE: { "#ancilla": "n-1", tSE: "0.000001" },
  PREP: { time: "t1+d*tSE", "#SE": "d", "#ancilla": "0" },
  OPL: {
    Z: { arity: 1, time: "t1+d*tSE", "#SE": "d", "#ancilla": "0" },
    X: { arity: 1, time: "t1+d*tSE", "#SE": "d", "#ancilla": "0" },
    H: { arity: 1, time: "t1+d*tSE", "#SE": "d", "#ancilla": "0" }
  },
  OPF: {
    faultyT: { arity: 1, time: "2t1+2tm", pF: "max(p1, p2, pm)", "#ancilla": "0" }
  },
  tdec: "0",
  pL: "0.1*(max(p1,p2,pm)/0.01)^((d+1)/2)",
  naux: "2*d*d"
};

def rotation1(P: Pauli, q0: Codeblock) {
  logical anc := new surface_code;
  if M(PZ)[q0, anc]; then X[anc];
  if M(faultyT)[anc]; then P[q0];
  release(anc);
}

def rotation3(P: Pauli, q0: Codeblock, q1: Codeblock, q2: Codeblock) {
  logical anc := new surface_code;
  if M(PZ)[q0, q1, q2, anc]; then X[anc];
  if M(faultyT)[anc]; then P[q0, q1, q2];
  release(anc);
}

def rotation5(P: Pauli, q0: Codeblock, q1: Codeblock, q2: Codeblock, q3: Codeblock, q4: Codeblock) {
  logical anc := new surface_code;
  if M(PZ)[q0, q1, q2, q3, q4, anc]; then X[anc];
  if M(faultyT)[anc]; then P[q0, q1, q2, q3, q4];
  release(anc);
}

def distill_circuit(q0: Codeblock, q1: Codeblock) {
  logical anc[3] := new surface_code;
  prepare(anc[0]) || prepare(anc[1]) || prepare(anc[2]);
  H[q0] || H[q1] || H[anc[0]] || H[anc[1]] || H[anc[2]];
  call rotation1(Z, anc[0]);
  call rotation1(Z, anc[1]);
  call rotation1(Z, anc[2]);
  call rotation3(ZZZ, anc[0], anc[1], anc[2]);
  call rotation3(ZZZ, q0, q1, anc[0]);
  call rotation3(ZZZ, q0, q1, anc[1]);
  call rotation3(ZZZ, q0, q1, anc[2]);
  call rotation5(ZZZZZ, q0, q1, anc[0], anc[1], anc[2]);
  call rotation3(ZZZ, q0, anc[0], anc[1]);
  call rotation3(ZZZ, q0, anc[0], anc[2]);
  call rotation3(ZZZ, q0, anc[1], anc[2]);
  call rotation3(ZZZ, q1, anc[0], anc[1]);
  call rotation3(ZZZ, q1, anc[0], anc[2]);
  call rotation3(ZZZ, q1, anc[1], anc[2]);
  (if M(X)[anc[0]]; then skip) || (if M(X)[anc[1]]; then skip) || (if M(X)[anc[2]]; then skip);
  release(anc);
}

program {
    logical q0 := new surface_code;
    logical q1 := new surface_code;
    call distill_circuit(q0, q1);
    release(q1);
    release(q0);
}
