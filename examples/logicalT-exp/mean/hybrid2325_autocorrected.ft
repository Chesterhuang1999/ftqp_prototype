
hardware superconducting = {
  t1: 1e-8, t2: 1e-7, tm: 1e-6, p1: 1e-3, p2: 2e-3, pm: 3e-3
};

qecc surface_code_23 using superconducting = {
  [[n,k,d]]: [529, 1, 23],
  SE: { "#ancilla": "n-1", tSE: "0.000001" },
  PREP: { time: "d*tSE", "#SE": "d", "#ancilla": "0" },
  OPL: {
    I: { arity: 1, time: "0", "#SE": "0", "#ancilla": "0" },
    X: { arity: 1, time: "d*tSE", "#SE": "d", "#ancilla": "0" },
    Z: { arity: 1, time: "d*tSE", "#SE": "d", "#ancilla": "0" },
    H: { arity: 1, time: "d*tSE", "#SE": "d", "#ancilla": "0" },
    measZ: { arity: 1, time: "d*tSE", "#SE": "d", "#ancilla": "0" }
  },
  OPF: {
    faultyT: { arity: 1, time: "2t1+2tm", pF: "max(p1, p2, pm)", "#ancilla": "0"
    }
  },
  tdec: "200*tSE",
  pL: "0.1*(max(p1,p2,pm)/0.0057)^((d+1)/2)",
  naux: "d*d"
};

qecc surface_code_25 using superconducting = {
  [[n,k,d]]: [625, 1, 25],
  SE: { "#ancilla": "n-1", tSE: "0.000001" },
  PREP: { time: "d*tSE", "#SE": "d", "#ancilla": "0" },
  OPL: {
    I: { arity: 1, time: "0", "#SE": "0", "#ancilla": "0" },
    X: { arity: 1, time: "d*tSE", "#SE": "d", "#ancilla": "0" },
    Z: { arity: 1, time: "d*tSE", "#SE": "d", "#ancilla": "0" },
    H: { arity: 1, time: "d*tSE", "#SE": "d", "#ancilla": "0" },
    measZ: { arity: 1, time: "d*tSE", "#SE": "d", "#ancilla": "0" }
  },
  OPF: {
    faultyT: { arity: 1, time: "2t1+2tm", pF: "max(p1, p2, pm)", "#ancilla": "0"
    }
  },
  tdec: "280*tSE",
  pL: "0.1*(max(p1,p2,pm)/0.0057)^((d+1)/2)",
  naux: "d*d"
};

def auto_corrected_implementation(q: Codeblock) {
    logical anc[2] := new surface_code_23;
    // call distill15to1(anc[0]);
    if M(ZZ)[q, anc[0]]; {
        if M(ZY)[anc[0], anc[1]]; {
            H[q];H[q];H[q];H[q];H[q];H[q];
            H[q];H[q];H[q];H[q];H[q];H[q];
            H[q];H[q];H[q];H[q];H[q];H[q];
            H[q];H[q];H[q];H[q];H[q];H[q];
            H[q];H[q];H[q];H[q];H[q];H[q];
            H[q];H[q];H[q];H[q];H[q];H[q];
        }
        then {
            if M(X)[anc[0]]; then Z[q];
        }
    } then H[anc[1]];
    if M(Z)[anc[1]]; then skip; // controlled X/Z measurement.
    release(anc);
}

program {
  logical q := new surface_code_25;
  call auto_corrected_implementation(q);
  release(q);
}