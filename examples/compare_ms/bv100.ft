hardware qubit_gate_ns_e4 = {
  t1: 100, t2: 100, tm: 500, p1: 1e-4, p2: 1e-4, pm: 1e-4
};

qecc ms_like_100 using qubit_gate_ns_e4 = {
  [[n,k,d]]: [100989, 101, 21],             // n = (2k + ceil(sqrt(8k)) + 1) * (d * d) = 441*441 = 194481
  SE: { "#ancilla": "(2*k + ceil(sqrt(8*k)) + 1) * (d * d - 1)", tSE: "4t1+2tm" }, 
  PREP: { time: "d*tSE", "#SE": "0", "#ancilla": "0" },
  OPL: {
    X: { arity: 1, time: "0", "#SE": "0", "#ancilla": "0" },
    Z: { arity: 1, time: "0", "#SE": "0", "#ancilla": "0" },
    H: { arity: 1, time: "0", "#SE": "0", "#ancilla": "0" },
